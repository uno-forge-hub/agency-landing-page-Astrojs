---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";

const logos = [
    {
        src: "/logos/spotify.png",
        alt: "Spotify",
    },
    {
        src: "/logos/slack.png",
        alt: "Slack",
    },
    {
        src: "/logos/paypallogo.png",
        alt: "PayPal",
    },
];
---

<section>
    <Container className="space-y-8">
        <div class="text-center max-w-3xl mx-auto">
            <Title>
                Trusted by companies like
            </Title>
        </div>
        <div class="relative overflow-hidden">
            <div class="overflow-hidden mb-4">
                <div class="marquee-track marquee-left flex w-max">
                    <div class="flex shrink-0 gap-6 pr-6">
                        {
                            logos.map((logo) => (
                                <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group shrink-0">
                                    <img src={logo.src} width="100" height="60" alt={logo.alt} class="h-7 sm:h-10 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"/>
                                </div>
                            ))
                        }
                    </div>
                    <div class="flex shrink-0 gap-6 pr-6">
                        {
                            logos.map((logo) => (
                                <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group shrink-0" >
                                    <img src={logo.src} width="100" height="60" alt={logo.alt} class="h-7 sm:h-10 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"/>
                                </div>
                            ))
                        }
                    </div>                    
                    <div class="flex shrink-0 gap-6 pr-6">
                         {
                            logos.map((logo) => (
                                <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group shrink-0" >
                                    <img src={logo.src} width="100" height="60" alt={logo.alt} class="h-7 sm:h-10 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"/>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
            <div class="overflow-hidden">
                <div class="marquee-track marquee-right flex w-max">
                 
                    <div class="flex shrink-0 gap-6 pr-6">
                        {
                            logos.map((logo) => (
                                <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group shrink-0">
                                    <img src={logo.src} width="100" height="60" alt={logo.alt} class="h-7 sm:h-10 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"/>
                                </div>
                            ))
                        }
                    </div>
                    <div class="flex shrink-0 gap-6 pr-6">
                         {
                            logos.map((logo) => (
                                <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group shrink-0">
                                    <img src={logo.src} width="100" height="60" alt={logo.alt} class="h-7 sm:h-10 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"/>
                                </div>
                            ))
                        }
                    </div>
                    <div class="flex shrink-0 gap-6 pr-6">
                        {
                            logos.map((logo) => (
                                <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group shrink-0">
                                    <img src={logo.src} width="100" height="60" alt={logo.alt} class="h-7 sm:h-10 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105"/>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </Container>
</section>

<style>
    .marquee-track {
        will-change: transform;
    }
    .marquee-left {
        animation: marquee-left 25s linear infinite;
    }
    .marquee-right {
        animation: marquee-right 30s linear infinite;
    }
    .marquee-track:hover {
        animation-play-state: paused;
    }
    @keyframes marquee-left {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-33.333333%);
        }
    }
    @keyframes marquee-right {
        from {
            transform: translateX(-33.333333%);
        }

        to {
            transform: translateX(0);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .marquee-track {
            animation: none;
        }
    }
</style>